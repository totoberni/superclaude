#!/usr/bin/env bash
# /notebook skill — CLI entry point.
# All subcommands route through nb_main.py via the skill's bundled Python.
# Project venv is required: skill imports nbformat / jupytext / nbclient / nbdime / pylatexenc / psutil.
#
# Wrapper sottile (Git Bash e POSIX): sceglie solo un interprete di avvio.
# L'interprete giusto (venv del progetto) lo risolve nb_main.py, che si rilancia da solo.

set -euo pipefail

SKILL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

BOOT=""
for cand in \
    "${VIRTUAL_ENV:-}/Scripts/python.exe" \
    "${VIRTUAL_ENV:-}/bin/python" \
    "$HOME/.claude/.venv/Scripts/python.exe" \
    "$HOME/.claude/.venv/bin/python"; do
  if [[ -f "$cand" ]]; then
    BOOT="$cand"
    break
  fi
done
if [[ -z "$BOOT" ]]; then
  BOOT="$(command -v python3 || command -v python || true)"
fi
if [[ -z "$BOOT" ]]; then
  echo "[notebook] no Python interpreter found (expected ~/.claude/.venv)" >&2
  exit 127
fi

exec "$BOOT" "${SKILL_DIR}/nb_main.py" "$@"
