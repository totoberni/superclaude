{
  "_comment": "Registrazione degli hook superclaude: unica fonte di verita'. Ha la forma esatta del valore della chiave 'hooks' di settings.json, con due segnaposto ({{PYTHON}} = interprete di base, {{DISPATCH}} = hooks/dispatch.py) che scripts/settings/apply_settings.py sostituisce (lanciatore: bin/apply-settings.ps1 -Profile superclaude|deepseek). Forma exec ovunque: 'args' e' la lista degli argomenti, niente shell e niente espansione di variabili. I filtri 'if' compaiono solo dove nessuna guardia viene ristretta: la tabella delle decisioni sta in docs/hooks-registration.md.",
  "SessionStart": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "{{PYTHON}}",
          "args": ["-S", "{{DISPATCH}}", "SessionStart"],
          "timeout": 15
        }
      ]
    }
  ],
  "SubagentStart": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "{{PYTHON}}",
          "args": ["-S", "{{DISPATCH}}", "SubagentStart"],
          "timeout": 10
        }
      ]
    }
  ],
  "PreToolUse": [
    {
      "matcher": "Bash|PowerShell|Monitor|Write|Edit|MultiEdit|NotebookEdit|Agent|Read|Glob|Grep",
      "hooks": [
        {
          "type": "command",
          "command": "{{PYTHON}}",
          "args": ["-S", "{{DISPATCH}}", "PreToolUse"],
          "timeout": 10
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "Agent",
      "hooks": [
        {
          "type": "command",
          "command": "{{PYTHON}}",
          "args": ["-S", "{{DISPATCH}}", "PostToolUse"],
          "timeout": 10
        }
      ]
    },
    {
      "matcher": "Write|Edit|MultiEdit",
      "hooks": [
        {
          "type": "command",
          "command": "{{PYTHON}}",
          "args": ["-S", "{{DISPATCH}}", "PostToolUse"],
          "if": "Edit(//**/*.tex)",
          "timeout": 10
        }
      ]
    }
  ],
  "SubagentStop": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "{{PYTHON}}",
          "args": ["-S", "{{DISPATCH}}", "SubagentStop"],
          "timeout": 10
        }
      ]
    }
  ],
  "PreCompact": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "{{PYTHON}}",
          "args": ["-S", "{{DISPATCH}}", "PreCompact"],
          "timeout": 20
        }
      ]
    }
  ],
  "Stop": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "{{PYTHON}}",
          "args": ["-S", "{{DISPATCH}}", "Stop"],
          "timeout": 10
        }
      ]
    }
  ],
  "SessionEnd": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "{{PYTHON}}",
          "args": ["-S", "{{DISPATCH}}", "SessionEnd"],
          "timeout": 30
        }
      ]
    }
  ]
}
