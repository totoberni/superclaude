{
  "_comment": "Frammento di impostazioni del profilo superclaude, unito da apply_settings.py come deepseek.base.json per il profilo deepseek. Secondo livello nativo dietro al firewall degli hook: niente lettura o modifica dei dati del profilo deepseek (memoria, piani, comunicazioni, trascrizioni, stato, file temporanei, log, credenziali, .claude.json), niente modifica delle sue impostazioni, niente esecuzione dello script della chiave o di keyring/cmdkey. Le regole sui comandi coprono le forme di invocazione usuali (interprete python o py, percorso relativo, operatore di chiamata), non un binario richiamato in altro modo.",
  "permissions": {
    "deny": [
      "Read(~/.claude-deepseek/agent-memory/**)",
      "Edit(~/.claude-deepseek/agent-memory/**)",
      "Read(~/.claude-deepseek/plans/**)",
      "Edit(~/.claude-deepseek/plans/**)",
      "Read(~/.claude-deepseek/comms/**)",
      "Edit(~/.claude-deepseek/comms/**)",
      "Read(~/.claude-deepseek/projects/**)",
      "Edit(~/.claude-deepseek/projects/**)",
      "Read(~/.claude-deepseek/state/**)",
      "Edit(~/.claude-deepseek/state/**)",
      "Read(~/.claude-deepseek/tmp/**)",
      "Edit(~/.claude-deepseek/tmp/**)",
      "Read(~/.claude-deepseek/logs/**)",
      "Edit(~/.claude-deepseek/logs/**)",
      "Read(~/.claude-deepseek/.credentials.json)",
      "Edit(~/.claude-deepseek/.credentials.json)",
      "Read(~/.claude-deepseek/.claude.json)",
      "Edit(~/.claude-deepseek/.claude.json)",
      "Edit(~/.claude-deepseek/settings*.json)",
      "Bash(*python* *key-helper*)",
      "Bash(*python* *store-key*)",
      "Bash(py *key-helper*)",
      "Bash(py *store-key*)",
      "Bash(./key-helper*)",
      "Bash(./store-key*)",
      "Bash(key-helper*)",
      "Bash(store-key*)",
      "Bash(*python* -m keyring*)",
      "Bash(*python* -c *keyring*)",
      "Bash(keyring *)",
      "Bash(cmdkey *)",
      "PowerShell(*python* *key-helper*)",
      "PowerShell(*python* *store-key*)",
      "PowerShell(py *key-helper*)",
      "PowerShell(py *store-key*)",
      "PowerShell(./key-helper*)",
      "PowerShell(./store-key*)",
      "PowerShell(key-helper*)",
      "PowerShell(store-key*)",
      "PowerShell(& *key-helper*)",
      "PowerShell(& *store-key*)",
      "PowerShell(*python* -m keyring*)",
      "PowerShell(*python* -c *keyring*)",
      "PowerShell(keyring *)",
      "PowerShell(cmdkey *)"
    ]
  }
}
