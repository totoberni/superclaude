{
  "env": {
    "SC_PROFILE": "deepseek",
    "ANTHROPIC_BASE_URL": "https://api.deepseek.com/anthropic",
    "ANTHROPIC_MODEL": "deepseek-v4-pro",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "deepseek-v4-pro",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "deepseek-v4-pro",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "deepseek-flash",
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "deepseek-v4-pro",
    "ANTHROPIC_DEFAULT_MODEL": "deepseek-v4-pro",
    "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "1000000",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "786432",
    "CLAUDE_CODE_SUBPROCESS_ENV_SCRUB": "1",
    "DISABLE_AUTOUPDATER": "1",
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_DISABLE_OFFICIAL_MARKETPLACE_AUTOINSTALL": "1",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false",
    "HF_HUB_OFFLINE": "1",
    "TRANSFORMERS_OFFLINE": "1",
    "HF_HUB_DISABLE_SYMLINKS_WARNING": "1",
    "PYTHONUTF8": "1",
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
    "CLAUDE_COWORK_MEMORY_GUIDELINES": "Your persistent memory is a hybrid-search SQLite DB at ~/.claude-deepseek/agent-memory/.memory.db, the deepseek profile's own DB that mem resolves automatically (NOT Markdown files; there is no MEMORY.md to read). To recall, run: mem search \"<query>\" -k 8, then mem get <slug> for the full body. Query the DB proactively whenever a task touches a project, library, tool, or past decision. Memory is tiered (instance/<agent>, shared-projects, shared-global, class) and typed (feedback/project/reference/user). To write or update memory use the memory skills (/remember, /good-idea, /lt-mem, /mistake); never hand-write .md memory files."
  },
  "apiKeyHelper": "{{DS_HOME}}/.venv/Scripts/python.exe {{DS_HOME}}/bin/key-helper.py",
  "skipWebFetchPreflight": true,
  "statusLine": {
    "type": "command",
    "command": "{{DS_HOME}}/.venv/Scripts/python.exe {{DS_HOME}}/bin/ds-statusline.py"
  },
  "permissions": {
    "deny": [
      "Read(~/.claude/agent-memory/**)",
      "Edit(~/.claude/agent-memory/**)",
      "Read(~/.claude/plans/**)",
      "Edit(~/.claude/plans/**)",
      "Read(~/.claude/comms/**)",
      "Edit(~/.claude/comms/**)",
      "Read(~/.claude/projects/**)",
      "Edit(~/.claude/projects/**)",
      "Read(~/.claude/.credentials.json)",
      "Edit(~/.claude/.credentials.json)",
      "Edit(~/.claude/settings*.json)",
      "Edit(~/.claude-deepseek/settings*.json)",
      "Read(~/.claude.json)",
      "Edit(~/.claude.json)",
      "Read(~/.claude.json.backup*)",
      "Edit(~/.claude.json.backup*)",
      "Monitor",
      "Bash(*key-helper*)",
      "Bash(*store-key*)",
      "Bash(*keyring*)",
      "Bash(*cmdkey*)",
      "PowerShell(*key-helper*)",
      "PowerShell(*store-key*)",
      "PowerShell(*keyring*)",
      "PowerShell(*cmdkey*)"
    ]
  }
}
